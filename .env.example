# ==========================================================
# متغيرات البيئة لمنصة مخزوني (Al-Makhzoon)
# ==========================================================

# 1. إعدادات Supabase المحلي (Local Supabase CLI)
# العنوان الافتراضي لـ Supabase المحلي هو: http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ey...

# أو للاتصال بسحابة Supabase Cloud مباشرة على Vercel:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. مفتاح Google Gemini للتعرف البصري بالذكاء الاصطناعي (اختياري، يمكن أيضاً حفظه من شاشة الإعدادات)
VITE_GEMINI_API_KEY=
